   <dc:creator>
    <rdf:Seq>
     <rdf:li>Saman Iftikhar</rdf:li>
     <rdf:li>Ammar Rafiq and Syed Rizwan Hassan</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">ExLightNet: A Lightweight and Explainable 1D-CNN for Real-Time Intrusion Detection in Resource-Constrained IoT Sensor Networks</rdf:li>
     <rdf:li xml:lang="en-US">ExLightNet: A Lightweight and Explainable 1D-CNN for Real-Time Intrusion Detection in Resource-Constrained IoT Sensor Networks</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>IoT security; IoMT; intrusion detection system; lightweight deep learning; explainable artificial intelligence; SHAP; model quantisation; edge computing; network sensors</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:type>
    <rdf:Bag>
     <rdf:li>Text</rdf:li>
    </rdf:Bag>
   </dc:type>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Internet of Things (IoT) and Internet of Medical Things (IoMT) sensor deployments are pushing security decision-making from centralised servers towards resource-constrained edge gateways</rdf:li>
     <rdf:li xml:lang="en-US">Internet of Things (IoT) and Internet of Medical Things (IoMT) sensor deployments are pushing security decision-making from centralised servers towards resource-constrained edge gateways</rdf:li>
     <rdf:li xml:lang="x-default">where heavyweight deep learning detectors exceed the available compute</rdf:li>
     <rdf:li xml:lang="en-US">where heavyweight deep learning detectors exceed the available compute</rdf:li>
     <rdf:li xml:lang="x-default">memory</rdf:li>
     <rdf:li xml:lang="en-US">memory</rdf:li>
     <rdf:li xml:lang="x-default">and latency budgets</rdf:li>
     <rdf:li xml:lang="en-US">and latency budgets</rdf:li>
     <rdf:li xml:lang="x-default">and where opaque alarms erode operator trust. This paper proposes ExLightNet</rdf:li>
     <rdf:li xml:lang="en-US">and where opaque alarms erode operator trust. This paper proposes ExLightNet</rdf:li>
     <rdf:li xml:lang="x-default">a lightweight one-dimensional convolutional neural network that couples depthwise-separable convolutions and squeeze-and-excitation channel attention with a tempered class-balanced training recipe (focal loss plus $\sqrt {f^{-1}}$ sampling) and per-channel INT8 weight quantisation</rdf:li>
     <rdf:li xml:lang="en-US">a lightweight one-dimensional convolutional neural network that couples depthwise-separable convolutions and squeeze-and-excitation channel attention with a tempered class-balanced training recipe (focal loss plus $\sqrt {f^{-1}}$ sampling) and per-channel INT8 weight quantisation</rdf:li>
     <rdf:li xml:lang="x-default">and attaches SHAP attributions directly to the deployed model. We evaluate the framework on the public RT-IoT2022 benchmark of 123</rdf:li>
     <rdf:li xml:lang="en-US">and attaches SHAP attributions directly to the deployed model. We evaluate the framework on the public RT-IoT2022 benchmark of 123</rdf:li>
     <rdf:li xml:lang="x-default">117 real bidirectional flows from smart-home and sensor IoT devices spanning nine attack behaviours and three normal device classes</rdf:li>
     <rdf:li xml:lang="en-US">117 real bidirectional flows from smart-home and sensor IoT devices spanning nine attack behaviours and three normal device classes</rdf:li>
     <rdf:li xml:lang="x-default">an environment representative of the auxiliary sensing layer of home-based care settings. ExLightNet attains an attack-class recall (sensitivity) of 0.9976</rdf:li>
     <rdf:li xml:lang="en-US">an environment representative of the auxiliary sensing layer of home-based care settings. ExLightNet attains an attack-class recall (sensitivity) of 0.9976</rdf:li>
     <rdf:li xml:lang="x-default">missing only 40 of 16</rdf:li>
     <rdf:li xml:lang="en-US">missing only 40 of 16</rdf:li>
     <rdf:li xml:lang="x-default">592 attack flows</rdf:li>
     <rdf:li xml:lang="en-US">592 attack flows</rdf:li>
     <rdf:li xml:lang="x-default">with macro-F1 0.9860 and AUC 0.9985 for binary attack detection (the 99.49% accuracy is retained for comparability with prior work</rdf:li>
     <rdf:li xml:lang="en-US">with macro-F1 0.9860 and AUC 0.9985 for binary attack detection (the 99.49% accuracy is retained for comparability with prior work</rdf:li>
     <rdf:li xml:lang="x-default">but accuracy is a misleading headline metric under the severe class imbalance of network traffic)</rdf:li>
     <rdf:li xml:lang="en-US">but accuracy is a misleading headline metric under the severe class imbalance of network traffic)</rdf:li>
     <rdf:li xml:lang="x-default">and a macro-recall of 0.863 (97.70% accuracy</rdf:li>
     <rdf:li xml:lang="en-US">and a macro-recall of 0.863 (97.70% accuracy</rdf:li>
     <rdf:li xml:lang="x-default">macro-F1 0.8621) across twelve fine-grained classes</rdf:li>
     <rdf:li xml:lang="en-US">macro-F1 0.8621) across twelve fine-grained classes</rdf:li>
     <rdf:li xml:lang="x-default">surpassing a $4.5\times $ larger standard CNN on the binary task while remaining within 0.0021 macro-F1 of Random Forest. Post-quantisation</rdf:li>
     <rdf:li xml:lang="en-US">surpassing a $4.5\times $ larger standard CNN on the binary task while remaining within 0.0021 macro-F1 of Random Forest. Post-quantisation</rdf:li>
     <rdf:li xml:lang="x-default">the model shrinks from 162 KB to 37 KB ($4.4\times $) with a macro-F1 drop of at most 0.007</rdf:li>
     <rdf:li xml:lang="en-US">the model shrinks from 162 KB to 37 KB ($4.4\times $) with a macro-F1 drop of at most 0.007</rdf:li>
     <rdf:li xml:lang="x-default">sustaining 0.50 ms single-flow CPU latency</rdf:li>
     <rdf:li xml:lang="en-US">sustaining 0.50 ms single-flow CPU latency</rdf:li>
     <rdf:li xml:lang="x-default">$66\times $ faster than an accuracy-equivalent Random Forest. On a Raspberry Pi 4 gateway</rdf:li>
     <rdf:li xml:lang="en-US">$66\times $ faster than an accuracy-equivalent Random Forest. On a Raspberry Pi 4 gateway</rdf:li>
     <rdf:li xml:lang="x-default">the INT8 model sustains 2197 flow decisions per second across four Cortex-A72 cores</rdf:li>
     <rdf:li xml:lang="en-US">the INT8 model sustains 2197 flow decisions per second across four Cortex-A72 cores</rdf:li>
     <rdf:li xml:lang="x-default">21.4$\times $ faster than an accuracy-equivalent Random Forest</rdf:li>
     <rdf:li xml:lang="en-US">21.4$\times $ faster than an accuracy-equivalent Random Forest</rdf:li>
     <rdf:li xml:lang="x-default">confirming the deployment profile on measured gateway-class hardware. SHAP analysis shows that forward payload statistics</rdf:li>
     <rdf:li xml:lang="en-US">confirming the deployment profile on measured gateway-class hardware. SHAP analysis shows that forward payload statistics</rdf:li>
     <rdf:li xml:lang="x-default">backward header-size extremes</rdf:li>
     <rdf:li xml:lang="en-US">backward header-size extremes</rdf:li>
     <rdf:li xml:lang="x-default">and packet-rate features dominate decisions</rdf:li>
     <rdf:li xml:lang="en-US">and packet-rate features dominate decisions</rdf:li>
     <rdf:li xml:lang="x-default">yielding operator-readable rationales.</rdf:li>
     <rdf:li xml:lang="en-US">yielding operator-readable rationales.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:language>
    <rdf:Bag>
     <rdf:li>en-US</rdf:li>
    </rdf:Bag>
   </dc:language>
